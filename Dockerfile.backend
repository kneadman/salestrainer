FROM python:3.13-slim AS whisper-builder

ARG WHISPER_CPP_REF=v1.7.5
ARG WHISPER_MODEL=base

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt

RUN git clone --depth 1 --branch ${WHISPER_CPP_REF} https://github.com/ggml-org/whisper.cpp.git

WORKDIR /opt/whisper.cpp

RUN cmake -B build -DGGML_NATIVE=OFF && \
    cmake --build build --config Release -j"$(nproc)" --target whisper-cli

RUN bash ./models/download-ggml-model.sh ${WHISPER_MODEL}

RUN mkdir -p /opt/whisper-install/bin /opt/whisper-install/lib /opt/whisper-install/models && \
    cp /opt/whisper.cpp/build/bin/whisper-cli /opt/whisper-install/bin/whisper-cli && \
    find /opt/whisper.cpp/build -name "*.so*" -exec cp -P {} /opt/whisper-install/lib/ \; && \
    cp -a /opt/whisper.cpp/models/. /opt/whisper-install/models/


FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libc-bin \
    && rm -rf /var/lib/apt/lists/*

COPY --from=whisper-builder /opt/whisper-install/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=whisper-builder /opt/whisper-install/lib/ /usr/local/lib/
COPY --from=whisper-builder /opt/whisper-install/models /opt/whisper.cpp/models

COPY pyproject.toml README.md ./
COPY alembic.ini ./
COPY app ./app
COPY migrations ./migrations
COPY deploy/snapshot_scheduler.py ./deploy/snapshot_scheduler.py
COPY deploy/persona_pool_worker.py ./deploy/persona_pool_worker.py

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir .

RUN ldconfig && \
    ldd /usr/local/bin/whisper-cli | tee /tmp/whisper-ldd.txt && \
    ! grep -q "not found" /tmp/whisper-ldd.txt

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
