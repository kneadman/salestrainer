REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sales_trainer
SESSION_TTL_SECONDS=86400
APP_ENV=local
LOG_LEVEL=INFO
DEBUG_CLI=false
DEBUG_LLM_PAYLOAD=false
LLM_BACKEND=fake
ALLOW_FAKE_LLM_FALLBACK=true
ALLOW_IN_MEMORY_REPOSITORY=true
LLM_REQUEST_TIMEOUT_SECONDS=30
YANDEX_API_KEY=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_PERSONA_FOLDER_ID=
YANDEX_PERSONA_AGENT_ID=
YANDEX_DIALOGUE_FOLDER_ID=
YANDEX_DIALOGUE_AGENT_ID=
YANDEX_FOLDER_ID=
YANDEX_AGENT_ID=
SECRET_ENCRYPTION_KEY=replace-with-random-32-plus-character-secret
STT_ENABLED=false
STT_BACKEND=fake
STT_LANGUAGE=ru
STT_MAX_UPLOAD_BYTES=6000000
STT_MAX_AUDIO_SECONDS=90
STT_TIMEOUT_SECONDS=120
STT_CONCURRENCY=1
STT_QUEUE_WAIT_TIMEOUT_SECONDS=20
STT_PER_USER_CONCURRENCY=1
STT_TEMP_DIR=/tmp/salestrainer-stt
STT_WHISPER_CPP_BINARY=
STT_MODEL_PATH=
STT_FFPROBE_BINARY=ffprobe
STT_NORMALIZATION_MODE=light
