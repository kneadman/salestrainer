REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sales_trainer
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=sales_trainer
SESSION_TTL_SECONDS=1800
AUTH_SESSION_TTL_SECONDS=1209600
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
APP_ENV=local
LOG_LEVEL=INFO
DEBUG_CLI=false
DEBUG_LLM_PAYLOAD=false
LLM_BACKEND=fake
ALLOW_FAKE_LLM_FALLBACK=true
ALLOW_IN_MEMORY_REPOSITORY=true
# Per-request LLM HTTP timeout. Reasoning models need more headroom; a persona
# generation call may also retry once on schema validation failure. Anything set
# here must stay below the nginx proxy_read_timeout in deploy/nginx/default.conf.
LLM_REQUEST_TIMEOUT_SECONDS=30

# OpenAI-compatible router settings (used when LLM_BACKEND=openai_compatible).
# LLM_BASE_URL points at any OpenAI-compatible router (OpenRouter, VseGPT, self-hosted gateway, ...).
# Switch providers by changing this URL plus the key and model names below - no code changes.
LLM_BASE_URL=
LLM_API_KEY=
# Wire protocol: chat_completions (default, most routers) or responses (OpenAI responses API).
LLM_API_STYLE=chat_completions
# Response format requested from the router for structured roles (dialogue, persona, judge):
# json_schema, json_object, or none. The summary compressor always uses plain text.
LLM_RESPONSE_FORMAT=json_schema
# Hidden reasoning control for reasoning models (deepseek-v4-flash, ...).
# Reasoning models spend seconds thinking before answering a 1-3 sentence client
# reply, which dominates session-start latency.
#   provider_default - send nothing, let the model decide (safest, slowest)
#   off              - disable hidden thinking (fastest; verified on routerai)
#   effort:minimal|low|medium|high - explicit reasoning budget
LLM_REASONING_MODE=provider_default
# Default model used for every role when a role-specific model is not set.
LLM_MODEL=
LLM_DIALOGUE_MODEL=
LLM_PERSONA_MODEL=
LLM_JUDGE_MODEL=
LLM_SUMMARY_MODEL=

# Legacy Yandex Agents provider (used when LLM_BACKEND=yandex_compatible).
YANDEX_API_KEY=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_PERSONA_FOLDER_ID=
YANDEX_PERSONA_AGENT_ID=
YANDEX_DIALOGUE_FOLDER_ID=
YANDEX_DIALOGUE_AGENT_ID=
YANDEX_FOLDER_ID=
YANDEX_AGENT_ID=
SECRET_ENCRYPTION_KEY=replace-with-random-32-plus-character-secret
# Comma-separated trusted proxy IPs/CIDRs allowed to supply X-Forwarded-For/X-Real-IP.
# For Docker bridge deployments this may be the frontend/nginx container subnet.
TRUSTED_PROXY_IPS=
STT_ENABLED=false
STT_BACKEND=fake
STT_LANGUAGE=ru
STT_MAX_UPLOAD_BYTES=6000000
STT_MAX_AUDIO_SECONDS=90
STT_TIMEOUT_SECONDS=120
STT_CONCURRENCY=1
# STT_CONCURRENCY is the global max concurrent STT jobs kept for backward compatibility.
STT_MAX_CONCURRENT_JOBS=1
STT_QUEUE_WAIT_TIMEOUT_SECONDS=20
STT_PER_USER_CONCURRENCY=1
STT_RATE_LIMIT_ATTEMPTS=20
STT_RATE_LIMIT_WINDOW_SECONDS=3600
STT_GLOBAL_RATE_LIMIT_ATTEMPTS=120
STT_REJECT_UNKNOWN_DURATION=true
STT_TEMP_DIR=/tmp/salestrainer-stt
STT_WHISPER_CPP_BINARY=/usr/local/bin/whisper-cli
STT_MODEL_PATH=/opt/whisper.cpp/models/ggml-base.bin
STT_FFPROBE_BINARY=ffprobe
STT_FFMPEG_BINARY=ffmpeg
STT_NORMALIZATION_MODE=light

# Telegram notifications for landing leads (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEAD_CHAT_ID=

# Yandex.Metrika counter ID (optional, used only in production builds)
VITE_YANDEX_METRIKA_ID=109415411

# Pre-generated persona reserve. Session start normally pays one full LLM call
# to generate a persona; the pool keeps ready personas per training config so
# "start training" is instant and the call moves to a background worker.
# PERSONA_POOL_ENABLED=false or PERSONA_POOL_TARGET_SIZE=0 disables the pool.
PERSONA_POOL_ENABLED=true
PERSONA_POOL_TARGET_SIZE=8
PERSONA_POOL_LOW_WATERMARK=3
PERSONA_POOL_REFILL_BATCH_SIZE=4
PERSONA_POOL_REFILL_INTERVAL_SECONDS=120
